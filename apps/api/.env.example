PAYMENT_DEFAULT_CURRENCY=IDR
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_REFUND_URL=https://api.xendit.co/refunds
QRIS_ENABLED=false
QRIS_PROVIDER=xendit
PAYMENT_MODE=dummy
DUMMY_PAYMENT_WEBHOOK_SECRET=replace-with-a-development-only-secret
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
DATABASE_URL=postgresql://pos_app:password@localhost:5432/pos_hybrid

# ---- JWT ----
JWT_ACCESS_SECRET=CHANGE_ME_to_a_unique_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_to_a_different_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=24h

# ---- Database Health Check ----
DB_HEALTH_CHECK_INTERVAL_MS=30000

# ---- Development Login (non-production only) ----
# Set ALLOW_DEV_LOGIN=true hanya di environment development untuk bypass DB sementara.
# Tidak boleh diaktifkan di production.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_EMAIL=admin@dev.local
DEV_LOGIN_PASSWORD=CHANGE_ME

# ---- OAuth 2.0 (opsional) ----
# Jika dikonfigurasi, sistem akan memverifikasi Bearer token via JWKS URI.
# Jika tidak dikonfigurasi, sistem menggunakan JWT internal saja.
# OAUTH_JWKS_URI=https://your-oauth-provider.example.com/.well-known/jwks.json
# OAUTH_ISSUER=https://your-oauth-provider.example.com
# OAUTH_AUDIENCE=pos-hybrid-api

# ---- API Key ----
# Prefix yang ditambahkan di depan setiap raw API key yang di-generate.
API_KEY_PREFIX=pk_live_

# ---- Admin Database (untuk provisioning merchant) ----
# Koneksi ini digunakan oleh script provision-merchant.js.
# Role di sini harus bisa bypass RLS atau superuser.
# Di development boleh sama dengan DATABASE_URL.
# Di production, gunakan role/user yang berbeda dari pos_app.
# ADMIN_DATABASE_URL=postgresql://postgres:admin_password@localhost:5432/pos_hybrid

# ---- Production Hardening (Phase 4.2–4.3) ----
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# CORS allowlist — comma-separated origin; kosong = allow all (hanya untuk dev!)
# Contoh: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Trust proxy — jumlah hop proxy di depan app (1 = satu ALB/nginx).
# Dibutuhkan agar request.ip = IP asli client (untuk rate limit & logging).
TRUST_PROXY=1

# Redis (opsional) — untuk cache & rate limit di multi-instance.
# Tanpa nilai ini, aplikasi pakai in-memory cache (single instance only).
# REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=300
INVENTORY_CACHE_TTL_SECONDS=300